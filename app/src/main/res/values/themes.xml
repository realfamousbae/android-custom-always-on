<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Окна приложения (контент рисует Compose) -->
    <style name="Theme.StandBy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Режим StandBy: чёрный фон с первого кадра, без анимации появления (не «вспыхивает») -->
    <style name="Theme.StandBy.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
